# Lovable Cloud / Supabase — Client (Vite, browser-safe)
# Werte findest du in Lovable Cloud → Projekt-Einstellungen.
# Diese Datei nach `.env` kopieren und Werte einsetzen.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional (nur falls die App einen eigenen API-Endpunkt nutzt)
# VITE_API_BASE_URL=
